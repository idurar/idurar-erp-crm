doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    include documentStyles.pug
  body
    .document
      table.header-table
        tr
          td
            if companyLogo
              img.logo(src=companyLogo alt='Firmenlogo')
          td.issuer
            if settings.company_name
              p.issuer-name #{settings.company_name}
            if settings.company_address
              p #{settings.company_address}
            if settings.company_state || settings.company_country
              p #{[settings.company_state, settings.company_country].filter(Boolean).join(', ')}

      table.details-table
        tr
          td.recipient
            span.label #{model.documentType === 'credit_note' ? 'Gutschriftsempfänger' : 'Rechnungsempfänger'}
            p.recipient-name #{model.client.name}
            if model.client.address
              p #{model.client.address}
            if model.clientVatNumber || model.client.vatNumber
              p UID: #{model.clientVatNumber || model.client.vatNumber}
          td
            table.document-data
              tr
                td #{model.documentType === 'credit_note' ? 'Gutschriftnr.:' : 'Rechnungsnr.:'}
                td #{model.number}/#{model.year || ''}
              tr
                td Datum:
                td #{moment(model.date).format(dateFormat)}
              tr
                td Leistungsdatum:
                td #{moment(model.serviceDate || model.date).format(dateFormat)}
              tr
                td Fällig am:
                td #{moment(model.expiredDate).format(dateFormat)}

      .title-row
        h1 #{model.documentType === 'credit_note' ? 'Gutschrift' : 'Rechnung'} #{model.number}/#{model.year || ''}

      .intro
        p Sehr geehrte Damen und Herren,
        if model.documentType === 'credit_note'
          p Gutschrift zur ursprünglichen Rechnung. Grund: #{model.creditReason}
        else
          p Vielen Dank für Ihren Auftrag. Wir erlauben uns, folgende Leistungen in Rechnung zu stellen:

      table.items
        colgroup
          col(style='width: 5%')
          col(style='width: 38%')
          col(style='width: 10%')
          col(style='width: 10%')
          col(style='width: 14%')
          col(style='width: 10%')
          col(style='width: 13%')
        thead
          tr
            th Pos.
            th Beschreibung
            th Menge
            th Einheit
            th Einzelpreis
            th USt.
            th Gesamtpreis
        tbody
          each item, index in model.items
            tr
              td #{index + 1}.
              td
                .item-name #{item.itemName}
                if item.description
                  .description-rich!= safeRichText(item.description)
              td #{item.quantity}
              td #{item.unit || 'Stk.'}
              td #{moneyFormatter({ amount: item.price })}
              td #{model.taxRate} %
              td #{moneyFormatter({ amount: item.total })}

      table.settlement-table
        tr
          td
            if model.paymentQrCode
              .qr-payment
                img(src=model.paymentQrCode alt='QR-Code zur Zahlung')
                .qr-caption QR-Code scannen und bezahlen
            else
              .payment-hint
                p Bitte überweisen Sie den offenen Betrag fristgerecht.
                p Verwenden Sie die Rechnungsnummer als Zahlungsreferenz.
          td
            table.summary(style='width: 100%')
              tr
                td.sum-label Netto
                td #{moneyFormatter({ amount: model.subTotal })}
              tr
                td.sum-label USt. #{model.taxRate} %
                td #{moneyFormatter({ amount: model.taxTotal })}
              tr.grand
                td.sum-label Gesamtbetrag
                td #{moneyFormatter({ amount: model.total })}
              if model.discount
                tr
                  td.sum-label Rabatt
                  td - #{moneyFormatter({ amount: model.discount })}
              if model.dunningFees
                tr
                  td.sum-label Mahngebühren
                  td + #{moneyFormatter({ amount: model.dunningFees })}
              if model.credit
                tr
                  td.sum-label Bereits bezahlt
                  td - #{moneyFormatter({ amount: model.credit })}
              if model.credit || model.discount || model.dunningFees
                tr.grand
                  td.sum-label Offener Betrag
                  td #{moneyFormatter({ amount: model.total + (model.dunningFees || 0) - (model.discount || 0) - model.credit })}

      .info-box
        h2 Zahlung & Bankverbindung
        if model.paymentTermsText
          p #{model.paymentTermsText}
        else
          p Bitte überweisen Sie den offenen Betrag fristgerecht unter Angabe der Rechnungsnummer.
        if settings.company_iban || settings.company_bank_account
          table.bank-table
            tr
              td
                span.label Kontoinhaber
                | #{settings.company_account_holder || settings.company_name || ''}
              td
                span.label IBAN
                | #{settings.company_iban || settings.company_bank_account}
            if settings.company_bank_name || settings.company_bic
              tr
                td
                  span.label Bank
                  | #{settings.company_bank_name || '—'}
                td
                  span.label BIC
                  | #{settings.company_bic || '—'}

      if model.footerText || settings.invoice_pdf_footer
        .closing #{model.footerText || settings.invoice_pdf_footer}

      .legal-footer
        table.footer-table
          tr
            td
              p.issuer-name #{settings.company_name || ''}
              p #{settings.company_address || ''}
              p #{[settings.company_state, settings.company_country].filter(Boolean).join(', ')}
            td
              if settings.company_vat_number
                p UID: #{settings.company_vat_number}
              if settings.company_tax_number
                p Steuernummer: #{settings.company_tax_number}
              if settings.company_reg_number
                p Firmenbuchnummer: #{settings.company_reg_number}
            td
              if settings.company_email
                p #{settings.company_email}
              if settings.company_phone
                p #{settings.company_phone}
              if settings.company_website
                p #{settings.company_website}
