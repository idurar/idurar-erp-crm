NODE_ENV=development
PORT=8888
DATABASE=mongodb://localhost:27017/wiepilot
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_SERVER_FILE=http://localhost:8888/

# Optional mail delivery
RESEND_API=
RESEND_FROM=
EMAIL_DELIVERY_REQUIRED=false

# Licensing. Use one shared central MongoDB for all customer installations to enforce global one-time keys.
LICENSE_DATABASE=mongodb://localhost:27017/wiepilot-licenses
# Optional stable deployment identifier. Otherwise one is generated in the local ERP database.
LICENSE_INSTANCE_ID=
# Keep enabled in production. Set to false only for explicit local development bypass.
LICENSE_ENFORCEMENT=true
# Enable only after LICENSE_DATABASE and LICENSE_INSTANCE_ID are centrally configured.
LICENSE_REQUIRE_CENTRAL=false
SUPPORT_EMAIL=
